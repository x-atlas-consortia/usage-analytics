[ProcessSpecificSettings]
PROJECT_NAME=portfolio-monitoring
SLACK_NOTIFICATION_CHANNEL=log-processing
SLACK_BAD_NEWS_EMOJI=:bangbang:
SLACK_NEUTRAL_NEWS_EMOJI=:neutral_face:
SLACK_GOOD_NEWS_EMOJI=:white_check_mark:
SLACK_START_INFO_EMOJI=:bell:
SLACK_BAD_ITEM_EMOJI=:heavy_minus_sign:
SLACK_NEUTRAL_ITEM_EMOJI=:heavy_equals_sign:
SLACK_GOOD_ITEM_EMOJI=:heavy_plus_sign:
SLACK_NOTIFICATIONS=ENABLED
SLACK_USER_ID_MENTIONS_ON_ERROR={}
SLACK_USER_ID_MENTIONS_ON_SUCCESS={}

# Comma-separated list of keys to monitor.
# Each key must already be exposed by LogExtractXferUtils.get_config() -- i.e.
# declared in the shared logProcessingProject.ini's [LocalServerSettings] section.
#
# Keys listed here must also have a [KEY_NAME] section below, declaring characteristics
# to monitor as follows:
#
# FILE_SIZE_CHARACTERISTIC=APPEND_ONLY -- the referenced file should only grow between
# deliveries. Shrinking is not expected.
# FILE_SIZE_CHARACTERISTIC=VARIABLE -- the referenced file may occasionally be
# replaced (e.g. a downloaded reference database). Growing and shrinking are normal.
# STALE_THRESHOLD_HOURS -- the referenced file is considered stale when its mtime has not
# been update over this time period e.g. an expected replacement file has not been delivered.
[MonitoredFiles]
FILE_KEYS=TRANSFER_DETAIL_FILE,NONPUBLIC_GEO_DB

[TRANSFER_DETAIL_FILE]
FILE_SIZE_CHARACTERISTIC=APPEND_ONLY
# Deliveries land roughly once a day, so this defaults to a day plus a one-hour grace window.
STALE_THRESHOLD_HOURS=25

[NONPUBLIC_GEO_DB]
FILE_SIZE_CHARACTERISTIC=VARIABLE
# IP2Location publishes a new LITE release on the first day of each calendar month.
# Currently, this is manually refreshed.  Maybe a future job will automatically pull that
# release onto this server.  In the meantime, let's go ahead with a "bad news" message
# when it is stale, just to verify it works.
# Placeholder below is "a month plus a week of grace"
# (31 + 7 = 38 days = 912 hours).
STALE_THRESHOLD_HOURS=912
